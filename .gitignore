Build/

# Visual Studio solution and project files: regenerate with
#   dotnet <engine>/Engine/Binaries/DotNET/UnrealBuildTool/UnrealBuildTool.dll \
#     -projectfiles -project=game/Cataclysm.uproject -game -rocket -progress
*.sln
*.slnx
.vsconfig
.vs/
.idea/
*.VC.db
*.opensdf
*.sdf
*.suo

